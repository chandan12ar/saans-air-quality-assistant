# Server-side only. Never commit a real key (.env* is git-ignored except this file).
GEMINI_API_KEY=
# Copy current model IDs from Google AI Studio; they are intentionally not hard-coded.
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
# Optional per-IP request limits (defaults: 10 plans and 30 place searches per minute).
# RATE_LIMIT_PLAN_PER_MIN=10
# RATE_LIMIT_PLACES_PER_MIN=30
